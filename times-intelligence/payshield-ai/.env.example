# PayShield AI configuration (env vars; nested keys use __). NO secrets in this file:
# in Azure, secret values come from Key Vault references on the Container App.

PAYSHIELD_ENVIRONMENT=dev                      # local | dev | qa | sit | production
PAYSHIELD_LOG_LEVEL=INFO

# --- PostgreSQL (one server, one DB per tenant; names come from tenant.tenant.db_name) ---
PAYSHIELD_DB__HOST=<server>.postgres.database.azure.com
PAYSHIELD_DB__PORT=5432
PAYSHIELD_DB__USERNAME=payshield_svc
PAYSHIELD_DB__PASSWORD=                        # Key Vault ref, or leave empty with USE_ENTRA_AUTH=true
PAYSHIELD_DB__USE_ENTRA_AUTH=true
PAYSHIELD_DB__SSLMODE=require
PAYSHIELD_DB__TENANT_STORE_DATABASE=times-tenantstore-dev

# --- Keycloak (realm per tenant is resolved automatically) ---
PAYSHIELD_KEYCLOAK__AUTHORITY=https://<keycloak-host>
PAYSHIELD_KEYCLOAK__AUDIENCES=[]

# --- service-to-service (Azure Functions, payroll-api) ---
PAYSHIELD_SERVICE_AUTH__MODE=entra             # entra | shared_secret (local/dev only)
PAYSHIELD_SERVICE_AUTH__ENTRA_TENANT_ID=<entra-tenant-guid>
PAYSHIELD_SERVICE_AUTH__ENTRA_AUDIENCE=api://payshield-ai
PAYSHIELD_SERVICE_AUTH__ALLOWED_APP_IDS=["<functions-app-client-id>","<payroll-api-client-id>"]
PAYSHIELD_SERVICE_AUTH__REQUIRED_ROLE=PayShield.Service
PAYSHIELD_SERVICE_AUTH__SHARED_SECRET=

# --- model artifacts ---
PAYSHIELD_STORAGE__BACKEND=azure_blob          # local | azure_blob
PAYSHIELD_STORAGE__BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
PAYSHIELD_STORAGE__BLOB_CONTAINER=payshield-models
PAYSHIELD_STORAGE__LOCAL_ROOT=./.payshield-models

# --- Service Bus worker ---
PAYSHIELD_MESSAGING__SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
PAYSHIELD_MESSAGING__ANALYSIS_QUEUE=payshield-analysis-requested
PAYSHIELD_MESSAGING__MAX_DELIVERY_ATTEMPTS=5

# --- Azure OpenAI (assistant); disabled = deterministic answers only ---
PAYSHIELD_LLM__PROVIDER=disabled               # azure_openai | disabled
PAYSHIELD_LLM__AZURE_ENDPOINT=https://<resource>.openai.azure.com
PAYSHIELD_LLM__AZURE_DEPLOYMENT=<deployment-name>
PAYSHIELD_LLM__API_KEY=                        # empty = managed identity

# --- ML ---
PAYSHIELD_ML__MIN_TRAINING_OBSERVATIONS=150
PAYSHIELD_ML__MIN_TRAINING_PERIODS=6
PAYSHIELD_ML__ALERT_PERCENTILE=97
